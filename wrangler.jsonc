{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mohamad-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6dd0968d-8828-40db-97f5-a35ea15e2cc8","database_name": "mohamad-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "78cc18dfd3c642aca8074dc0ef2c49df" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
